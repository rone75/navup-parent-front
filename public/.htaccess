# Appli des parents NavUp : site statique (pages publiques prérendues) et appli rendue dans le navigateur.
# Ce fichier part avec le build (dist/navup-parent-front/browser/), à la racine du site.
Options -Indexes
DirectorySlash Off

RewriteEngine On

# Un fichier qui existe est servi tel quel
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Une page publique prérendue : /cgv → /cgv/index.html, sans redirection
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+?)/?$ /$1/index.html [L]

# Tout le reste (espace personnel, accès, retour de paiement) : la coque de l'appli, rendue dans le navigateur
RewriteRule ^ /index.csr.html [L]

<IfModule mod_headers.c>
    # Fichiers au nom haché par le build : gardés un an ; les pages, elles, se revérifient à chaque visite
    <FilesMatch "-[A-Z0-9]{8}\.(js|css|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-Frame-Options "DENY"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), usb=()"
    # NAVUP_CONNECT : les origines des deux API (« https://api.navup.fr https://api-espace.navup.fr »), posées dans le vhost.
    # Le paiement se fait par redirection vers Stripe : aucune source Stripe ici. Aucun script en ligne : ni relecture
    # des événements à l'hydratation, ni CSS critique en ligne (app.config.ts, angular.json).
    Header set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self' %{NAVUP_CONNECT}e; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
